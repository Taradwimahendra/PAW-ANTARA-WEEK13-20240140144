<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Invoice - <%= storeName %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/nav', { storeName, active: 'invoice', user: typeof user !== 'undefined' ? user : null }) %>

  <main class="container">
    <h2 style="font-size: 1.5rem; margin-bottom: 2rem;">Riwayat Invoice</h2>

    <% if (orders.length === 0) { %>
      <div class="card" style="text-align: center; padding: 3rem;">
        <p style="color: var(--text-muted);">Belum ada order masuk.</p>
      </div>
    <% } %>

    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <% orders.forEach(function(order) { %>
        <div class="card" style="padding: 1.5rem;">
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; margin-bottom: 1rem;">
            <div>
              <h3 style="font-size: 1.25rem; font-weight: 700;">INV-<%= String(order.id).padStart(5, '0') %></h3>
              <p style="color: var(--text-muted); font-size: 0.875rem;"><%= new Date(order.createdAt).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %></p>
            </div>
            <div style="text-align: right;">
              <span class="badge <%= order.status === 'pending' ? 'badge-pending' : (order.status === 'shipped' ? 'badge-shipped' : 'badge-admin') %>"><%= order.status.toUpperCase() %></span>
              <p style="margin-top: 0.5rem; font-size: 0.875rem;">Atas nama: <strong><%= order.buyerName %></strong></p>
            </div>
          </div>

          <div style="margin-bottom: 1.5rem;">
            <p style="font-weight: 600; margin-bottom: 0.5rem;">Detail Pesanan:</p>
            <ul style="list-style-type: none; padding: 0;">
              <% if (order.OrderItems && order.OrderItems.length > 0) { %>
                <% order.OrderItems.forEach(item => { %>
                  <li style="display: flex; justify-content: space-between; font-size: 0.875rem; padding: 0.25rem 0;">
                    <span><%= item.Product ? item.Product.name : '(Produk Dihapus)' %> (x<%= item.quantity %>)</span>
                    <span>Rp <%= new Intl.NumberFormat('id-ID').format(item.price * item.quantity) %></span>
                  </li>
                <% }) %>
              <% } else { %>
                <li style="font-size: 0.875rem; color: var(--text-muted);">Tidak ada detail (legacy order)</li>
              <% } %>
            </ul>
          </div>
          
          <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed var(--border-color); padding-top: 1rem;">
            <p style="font-size: 1.25rem; font-weight: 700;">Total: Rp <%= new Intl.NumberFormat('id-ID').format(order.totalAmount || 0) %></p>
            
            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
              <form action="/admin/invoices/<%= order.id %>/status" method="POST" style="display: flex; gap: 0.5rem;">
                <select name="status" class="form-control" style="width: auto; padding: 0.4rem 1rem;">
                  <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                  <option value="processed" <%= order.status === 'processed' ? 'selected' : '' %>>Diproses</option>
                  <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>Dikirim</option>
                </select>
                <button type="submit" class="btn btn-primary" style="padding: 0.4rem 1rem;">Update Status</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </main>
</body>
</html>
