<nav class="navbar">
  <a href="/" class="navbar-brand"><%= storeName %></a>
  <div class="navbar-nav">
    <a href="/" class="nav-link">Home</a>
    <a href="/cart" class="nav-link">Cart <% if(typeof cartCount !== 'undefined' && cartCount > 0) { %><span class="badge badge-admin"><%= cartCount %></span><% } %></a>
    
    <% if (typeof user !== 'undefined' && user && user.userId) { %>
      <% if (user.role === 'admin') { %>
        <a href="/admin/products" class="nav-link">Manage Products</a>
        <a href="/admin/invoices" class="nav-link">Invoices</a>
      <% } %>
      <span style="margin-left:1rem; color:var(--text-muted); font-weight:500;">Hi, <%= user.username %></span>
      <a href="/auth/logout" class="btn btn-danger" style="margin-left: 0.5rem; padding: 0.4rem 1rem;">Logout</a>
    <% } else { %>
      <a href="/auth/login" class="btn btn-primary" style="margin-left: 1rem;">Login</a>
    <% } %>
  </div>
</nav>
