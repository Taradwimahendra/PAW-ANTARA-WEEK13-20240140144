<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= storeName %> - Katalog</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/nav', { storeName, active: 'katalog' }) %>

  <main class="container animate-fade-in" style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-top: 2rem;">
    <!-- KATALOG -->
    <section>
      <% if (error) { %>
        <div style="background: rgba(254, 226, 226, 0.8); border: 1px solid #fca5a5; color: #b91c1c; padding: 1rem; border-radius: 12px; margin-bottom: 1rem; backdrop-filter: blur(4px);">
          <%= error %>
        </div>
      <% } %>

      <h2 style="font-size: 1.75rem; margin-bottom: 1.5rem; background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Produk Kami</h2>
      <div id="product-list" class="products-grid">
        <% products.forEach(function(product, index) { %>
          <div class="card animate-fade-in" style="animation-delay: <%= index * 0.1 %>s">
            <div class="card-body">
              <h3 class="product-title"><%= product.name %></h3>
              <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1rem; height: 60px; overflow: hidden;"><%= product.description %></p>
              <div class="product-price">Rp <%= new Intl.NumberFormat('id-ID').format(product.price) %></div>
              <p class="product-stock mb-4">Sisa Stok: <span class="badge badge-admin"><%= product.stock %></span></p>
              
              <form action="/cart/add" method="POST" style="display:flex; gap: 0.75rem; align-items:center;">
                <input type="hidden" name="productId" value="<%= product.id %>">
                <input type="number" name="quantity" min="1" max="<%= product.stock %>" value="1" class="form-control" style="width: 80px; padding: 0.5rem;" required>
                <button type="submit" class="btn btn-primary" style="flex: 1;" <%= product.stock === 0 ? 'disabled' : '' %>>
                  <%= product.stock === 0 ? 'Habis' : 'Add to Cart' %>
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- CHAT WIDGET -->
    <section class="card animate-fade-in delay-2" style="height: 650px; display: flex; flex-direction: column; position: sticky; top: 100px;">
      <div class="card-header" style="background: rgba(255,255,255,0.4);">
        <h2 style="font-size: 1.25rem; font-weight: 700;">💬 Tanya / Pesan Chat</h2>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">Coba: "bagusan produk A apa B?"</p>
      </div>

      <div id="chat-messages" style="flex: 1; overflow-y: auto; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;"></div>

      <form id="chat-form" style="border-top: 1px solid var(--border-color); padding: 1.25rem; display: flex; gap: 0.75rem; background: rgba(255,255,255,0.3);">
        <input
          id="chat-input"
          type="text"
          placeholder="Tanya produk..."
          class="form-control"
          autocomplete="off"
        />
        <button id="chat-submit" type="submit" class="btn btn-primary">Kirim</button>
      </form>
    </section>
  </main>

  <script src="/js/store.js"></script>
  <script src="/js/utils/formatChatText.js"></script>
  <script src="/js/chat.js"></script>
</body>
</html>
